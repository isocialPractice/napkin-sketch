{
  "name": "@isocialpractice/napkin-sketch",
  "version": "1.0.1",
  "description": "A drawing language and a graphic-design API that write SVG, PNG and PDF with no window, a command line any language can call, an embeddable sketching editor with auto-sharpen, and experimental AI helpers that draw from a request, read a graphic into a design language, and pose animation frames.",
  "author": "John Haugabook",
  "keywords": [
    "sketch",
    "drawing",
    "svg",
    "png",
    "pdf",
    "graphic-design",
    "design-language",
    "vector",
    "canvas",
    "electron",
    "gui",
    "napkin",
    "auto-sharpen",
    "hand-drawn",
    "touchscreen",
    "cli",
    "api",
    "ai",
    "agent",
    "claude-code"
  ],
  "license": "MIT",
  "homepage": "https://isocialpractice.github.io/napkin-sketch/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isocialPractice/napkin-sketch.git"
  },
  "bugs": {
    "url": "https://github.com/isocialPractice/napkin-sketch/issues"
  },
  "type": "commonjs",
  "bin": {
    "napkin-sketch": "dist/cli/index.js"
  },
  "main": "dist/api/index.js",
  "module": "dist/api/index.js",
  "types": "dist/api/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js",
      "default": "./dist/api/index.js"
    },
    "./node": {
      "types": "./dist/api/node.d.ts",
      "import": "./dist/node/index.js",
      "default": "./dist/node/index.js"
    },
    "./graphic-design": {
      "types": "./dist/core/graphic-design/index.d.ts",
      "import": "./dist/graphic-design/index.js",
      "default": "./dist/graphic-design/index.js"
    },
    "./sharpen": {
      "types": "./dist/sharpen/index.d.ts",
      "import": "./dist/sharpen/index.js",
      "default": "./dist/sharpen/index.js"
    },
    "./engines": {
      "types": "./dist/core/engines.d.ts",
      "import": "./dist/engines/index.js",
      "default": "./dist/engines/index.js"
    },
    "./graphic-design/files": {
      "types": "./dist/core/graphic-design/files.d.ts",
      "import": "./dist/graphic-design/files.js",
      "default": "./dist/graphic-design/files.js"
    },
    "./markdown": {
      "types": "./dist/markdown/index.d.ts",
      "import": "./dist/markdown/index.js",
      "default": "./dist/markdown/index.js"
    },
    "./styles.css": "./dist/renderer/styles.css"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/main",
    "!dist/embed",
    "!dist/renderer/renderer.js",
    "!dist/renderer/settings.js",
    "!dist/renderer/*.html",
    "!dist/renderer/accents",
    "!dist/cli/*.d.ts",
    "ai-helper",
    "!ai-helper/installed.json",
    "!ai-helper/**/assets/*.svg",
    "!ai-helper/**/assets/*.png",
    "!ai-helper/**/assets/*.json",
    ".claude-plugin",
    "scripts/install-ai-helper.mjs",
    "README.md",
    "API.md",
    "API-QUICKSTART.md",
    "API-CHEATSHEET.md",
    "docs/api",
    "!docs/api/**/*.html",
    "THIRD-PARTY-NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "build:watch": "node scripts/build.mjs --watch",
    "build:types": "tsc -p tsconfig.types.json",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:graphic-design-api": "node scripts/test-graphic-design-api.mjs",
    "import-tree": "node scripts/import-tree.mjs",
    "gui-check": "node --experimental-websocket test/gui/run.mjs",
    "todo": "node scripts/todo.mjs",
    "wireframe-cycles": "node scripts/wireframe-cycles.mjs",
    "shape-library": "node scripts/shape-library.mjs",
    "api-docs": "node scripts/api-docs.mjs",
    "menu-docs": "node scripts/menu-docs.mjs",
    "accent-languages": "node scripts/accent-languages.mjs",
    "site": "node scripts/site.mjs",
    "pack-check": "node scripts/pack-check.mjs",
    "pack-gui": "node scripts/pack-gui.mjs",
    "illustrated-frames": "node scripts/illustrated-frames.mjs",
    "frame-preview": "node scripts/frame-preview.mjs",
    "ai-helper": "node scripts/install-ai-helper.mjs",
    "animation-mode": "node scripts/animation-mode.mjs",
    "postinstall": "node scripts/install-ai-helper.mjs --on-clone",
    "start": "npm run build && node dist/cli/index.js --new",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "dist:linux": "npm run build && electron-builder --linux AppImage",
    "prepublishOnly": "npm run build && npm run build:types"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.23.0",
    "highlight.js": "11.12.0",
    "marked": "18.0.14",
    "marked-highlight": "2.2.4",
    "typescript": "^5.5.0"
  },
  "build": {
    "appId": "dev.napkinsketch.app",
    "productName": "Napkin Sketch",
    "copyright": "Copyright © napkin-sketch contributors",
    "extraMetadata": {
      "main": "dist/main/main.js",
      "name": "napkin-sketch"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/main/**/*",
      "dist/renderer/**/*",
      "dist/assets/**/*",
      "!dist/**/*.map",
      "!dist/**/*.d.ts",
      "package.json"
    ],
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "docs",
        "to": "docs",
        "filter": [
          "**/*",
          "!site-src/**"
        ]
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Napkin Sketch"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.graphics-design"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png",
      "category": "Graphics"
    }
  },
  "engines": {
    "node": ">=22.12"
  }
}
