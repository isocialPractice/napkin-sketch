  "menus": [
    { "id": "file", "label": "File", "type": "App", "accepts": [] },
    {
      "id": "edit",
      "label": "Edit",
      "type": "Composition",
      "accepts": [
        { "type": "edit:mixed", "group": 2 },
        { "type": "Subtract:element", "group": 3 },
        { "type": "edit:selection", "group": 3 }
      ]
    },
    { "id": "view", "label": "View", "type": "GUI", "accepts": [] },
    {
      "id": "transform",
      "label": "Transform",
      "type": "Draw",
      "accepts": ["Add:vector", "Modify:element", "Subtract:vector"],
      "help": { "label": "Transform", "page": "quickstart/transform", "order": 1 }
    },
    {
      "id": "sketch",
      "label": "Sketch",
      "type": "Draw",
      "accepts": ["Add:mark", "Modify:vector", "Subtract:mark"],
      "help": { "label": "Draw", "page": "quickstart/draw", "order": 2 }
    },
    {
      "id": "layers",
      "label": "Layers",
      "type": "App",
      "panel": "layers-panel",
      "accepts": ["Add:layer", "Modify:layer", "Subtract:layer", { "type": "edit:mixed", "group": 2, "when": "panel" }],
      "help": { "label": "Layers", "page": "quickstart/layers", "order": 4 }
    },
    {
      "id": "pages",
      "label": "Pages",
      "type": "App",
      "panel": "pages-panel",
      "accepts": [],
      "help": { "label": "Pages", "page": "quickstart/pages", "order": 3 }
    },
    {
      "id": "automate",
      "label": "Automate",
      "type": "API",
      "accepts": ["automate:mixed"],
      "help": { "label": "Automate", "page": "quickstart/automate", "order": 5 }
    },
    { "id": "help", "label": "Help", "type": "docs", "accepts": [] },
    {
      "id": "canvas",
      "label": "Canvas",
      "type": "Composition",
      "top": false,
      "panel": "canvas-wrap",
      "accepts": [
        { "type": "edit:mixed", "group": 1 },
        { "type": "Subtract:element", "group": 2 },
        { "type": "edit:selection", "group": 3 }
      ]
    },
    { "id": "export-button", "label": "Export", "type": "App", "top": false, "panel": "export", "from": "export" },
