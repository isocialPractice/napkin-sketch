napkin 1
# The Wipe Stacks as a block verb. Each wipe combines the marks its block
# draws, as Transform > Wipe Stacks does in the app, and what is left takes
# their place, painted as the topmost mark - or as the bottom one for
# out-front. Every cell in the top row wipes the same pair: a red square
# below and a blue circle above it.
page 780 320
name "wipe"
background #ffffff
layer "Wipes"
color #1f2328 width 2
define "pair" {
  fill #d0342c
  rect 0 0 70 70
  fill #27486d
  circle 70 70 40
}
define "venn" {
  fill #d0342c
  circle 40 40 40
  fill #27486d
  circle 80 40 40
  fill #2e7d5b
  circle 60 75 40
}
wipe in {
  place "pair" at 20 20
}
wipe out-front {
  place "pair" at 145 20
}
wipe out-back {
  place "pair" at 270 20
}
wipe mid {
  place "pair" at 395 20
}
wipe outer {
  place "pair" at 520 20
}
wipe clean {
  place "pair" at 645 20
}
# Three circles: Clean Wipe cuts seven pieces, each painted as the topmost
# circle over it; Outer Wipes keeps what an odd number of them cover, the
# middle included; Mid Wipe keeps what all three cover.
wipe clean {
  place "venn" at 20 170
}
wipe outer {
  place "venn" at 170 170
}
wipe mid {
  place "venn" at 320 170
}
# A line is its ink: a thick one taken from a square cuts the square in two.
wipe out-front {
  fill #ffe08a
  rect 470 170 110 110
  fill none
  width 14
  line 460 290 590 160
}
