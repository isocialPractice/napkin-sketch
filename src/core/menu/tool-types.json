      "fixed": "it is a view switch, kept on the keyboard, in Quick Settings and in the Move palette"
    },
    { "id": "quick-width", "label": "Quick Width", "type": "Draw:sketch", "inMenus": false, "fixed": "it starts a typed entry, so it stays on the keyboard", "summary": "Then type a number" },
    { "id": "quick-opacity", "label": "Quick Opacity", "type": "Draw:sketch", "inMenus": false, "fixed": "it starts a typed entry, so it stays on the keyboard", "summary": "Then type a number" },
    { "id": "quick-zoom", "label": "Quick Zoom", "type": "GUI:view", "inMenus": false, "fixed": "it starts a typed entry, so it stays on the keyboard", "summary": "Then a digit: `9` is 90%, `0` is 100%" },
