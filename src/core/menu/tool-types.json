  "subTypes": [
    { "id": "edit:mixed", "main": "Composition" },
    { "id": "Subtract:element", "main": "Composition" },
    { "id": "edit:selection", "main": "Composition" },
    { "id": "Add:vector", "main": "Draw" },
    { "id": "Modify:element", "main": "Draw" },
    { "id": "Subtract:vector", "main": "Draw" },
    { "id": "Add:mark", "main": "Draw" },
    { "id": "Modify:vector", "main": "Draw" },
    { "id": "Subtract:mark", "main": "Draw" },
    { "id": "Add:layer", "main": "App" },
    { "id": "Modify:layer", "main": "App" },
    { "id": "Subtract:layer", "main": "App" },
    { "id": "automate:mixed", "main": "API" }
