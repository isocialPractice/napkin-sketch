    { "id": "tool-fill", "label": "Fill Color", "type": "Draw:Modify:element", "inMenus": false, "summary": "Fills the element under the click, else the selection" },
    { "id": "tool-eyedrop", "label": "Eyedropper", "type": "Draw:Modify:element", "inMenus": false, "summary": "Hold `Ctrl` to pick a shape instead" },
    { "id": "clear-page", "label": "Clear", "name": "Clear Page", "type": "Composition:Subtract:element", "inMenus": false },
    {
      "id": "toggle-selection-borders",
      "label": "Show Selection Borders",
      "type": "GUI:view",
